self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")

models := import(":models")
geneMap := import(":gene-map")

self.defineOutputs("labelsCsv")

self.body(func(args) {
    // Input parameters
    countsParquet := args.countsParquet
    model := args.model
    species := args.species
    mode := args.mode
    mem := args.mem
    cpu := args.cpu

    // Resolve assets in template
    modelAsset := models.getModelAsset(model)
    modelName := models.getModelName(model)
    geneAsset := geneMap.getGeneAsset(species)
    geneAssetName := geneMap.getAssetName(species)

    // Cell type annotation software execution
    cellTypeAnnotation := exec.builder().
        software(assets.importSoftware("@platforma-open/milaboratories.cell-type-annotation.software:annotate-cell-types")).
        mem(mem).
        cpu(cpu).
        addFile("rawCounts.parquet", countsParquet).
        addAsset(modelAsset, "model", string(modelName)).
        addAsset(geneAsset, "geneAnnotation", string(geneAssetName)).
        arg("rawCounts.parquet").
        arg("labels.csv").
        arg("model/" + string(modelName)).
        arg("--gene_map").arg("geneAnnotation/" + string(geneAssetName)).
        arg("--mode").arg(string(mode)).
        arg("--clean_labels").arg("true").
        saveFile("labels.csv").
        cache(24 * 60 * 60 * 1000).
        run()

    // Get result file
    labelsCsv := cellTypeAnnotation.getFile("labels.csv")

    return {
        labelsCsv: labelsCsv
    }
})

