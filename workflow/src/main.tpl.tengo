wf := import("@platforma-sdk/workflow-tengo:workflow")
assets:= import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")

models := import(":models")
geneMap := import(":gene-map")

pfCellAnnotations := import(":pf-cell-annotations-conv")
cellTypeAnnotationTpl := assets.importTemplate(":cell-type-annotation-calculation")

wf.prepare(func(args){
	return {
		resolvedInput: wf.resolve(args.countsRef, { errIfMissing: true })
	}
})

wf.body(func(args) {

	blockId := wf.blockId().getDataAsJson()
	rawCounts := args.resolvedInput
	inputSpec := rawCounts.spec

	species := inputSpec.domain["pl7.app/species"]

	mode := args.mode
	// cleanLabels := args.cleanLabels

	// Set default conversion memory and CPU for the labels import
	// (one row per cell - orders of magnitude smaller than the counts matrix).
	defaultConvMem := "16GiB" // @TODO: set based on the size of the input
	defaultConvCpu := 1       // @TODO: set based on the size of the input

	// The counts export is the heaviest conversion in the block: the long-format counts p-column
	// holds one row per non-zero (cell, gene) pair, which reaches hundreds of millions of rows on
	// real datasets. Parquet keeps it columnar and streams through sink_parquet, instead of paying
	// CSV text encoding for three high-cardinality string columns.
	countsConvMem := "32GiB" // @TODO: set based on the size of the input
	countsConvCpu := 4       // @TODO: set based on the size of the input

	countsParquet := xsv.exportFrame([rawCounts], "parquet", { mem: countsConvMem, cpu: countsConvCpu })

	cellTypeAnnotationRender := render.create(cellTypeAnnotationTpl, {
		countsParquet: countsParquet,
		model: args.model,
		species: species,
		mode: mode,
		mem: "32GiB",
		cpu: 4
	})

	labelImportParams := pfCellAnnotations.getColumns(blockId, inputSpec)
	labelsPf := xsv.importFile(cellTypeAnnotationRender.output("labelsCsv"), "csv", labelImportParams, {splitDataAndSpec: true, mem: defaultConvMem, cpu: defaultConvCpu})

	// Create informative label with relevant cell type annotation parameters
	traceLabel := "Cell Type Annotation (" + args.model + ", mode:" + mode + ")"
	
	trace := pSpec.makeTrace(inputSpec,
		{type: "milaboratories.cell-type-annotation", id: blockId, importance: 80, label: traceLabel}
	)

	// Build cell type annotations pFrame with trace injection
	labelsOutputPf := pframes.pFrameBuilder()
	for k, v in labelsPf {
		labelsOutputPf.add(k, trace.inject(v.spec), v.data)
	}
	labelsOutputPf = labelsOutputPf.build()

	return {
		outputs: {
			labels: pframes.exportFrame(labelsOutputPf)
		},
		exports: {
			pf: labelsOutputPf
		}
	}
})

